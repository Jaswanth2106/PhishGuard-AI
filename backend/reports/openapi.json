          "cleaned_body"
        ],
        "title": "EmailFeatures"
      },
      "EmailPredictionRequest": {
        "properties": {
          "subject": {
            "type": "string",
            "minLength": 0,
            "title": "Subject",
            "description": "Email subject line."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "title": "Body",
            "description": "Raw email body text to classify."
          },
          "metadata": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata",
            "description": "Optional email metadata such as sender, reply_to, return_path, or precomputed feature values."
          }
        },
        "type": "object",
        "required": [
          "subject",
          "body"
        ],
        "title": "EmailPredictionRequest",
        "examples": [
          {
            "body": "Hi team, attached are the quarterly planning notes for review.",
            "metadata": {
              "reply_to": "manager@example.com"
            },
            "subject": "Quarterly planning notes"
          },
          {
            "body": "Immediate action required! Verify your bank account password now at http://verify-example.com/login",
            "subject": "URGENT account verification"
          }
        ]
      },
      "EmailPredictionResponse": {
        "properties": {
          "prediction": {
            "type": "string",
            "title": "Prediction",
            "description": "Model classification: legitimate or phishing_or_spam."
          },
          "label": {
            "type": "integer",
            "title": "Label",
            "description": "0 means legitimate; 1 means phishing_or_spam."
          },
          "confidence_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence Score",
            "description": "Distance-derived confidence for the selected class."
          },
          "probability_like_score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability Like Score",
            "description": "Sigmoid-normalized LinearSVC decision score for class 1."
          },
          "explanation": {
            "$ref": "#/components/schemas/PredictionExplanation"
          }
        },
        "type": "object",
        "required": [
          "prediction",
          "label",
          "confidence_score",
          "probability_like_score",
          "explanation"
        ],
        "title": "EmailPredictionResponse",
        "example": {
          "confidence_score": 0.8495,
          "explanation": {
            "decision_score": 1.731033,
            "feature_summary": {
              "attachment_keyword_count": 0,
              "average_word_length": 8.0,
              "character_count": 98,
              "cleaned_body": "Immediate action required! Verify your bank account password now at <URL>",
              "digit_ratio": 0.0,
              "email_count": 0,
              "exclamation_count": 1,
              "financial_keyword_count": 2,
              "has_reply_to": 0,
              "has_return_path": 0,
              "html_tag_count": 0,
              "ip_count": 0,
              "login_keyword_count": 4,
              "punctuation_ratio": 0.08,
              "question_count": 0,
              "sentence_count": 1,
              "subject_length": 27,
              "uppercase_ratio": 0.08,
              "urgency_keyword_count": 2,
              "url_count": 1,
              "word_count": 11
            },
            "model_version": "2.6.0",
            "threshold": 0.0,
            "top_signals": [
              "contains 1 URL(s)",
              "contains 4 login/account verification keyword(s)"
            ]
          },
          "label": 1,
          "prediction": "phishing_or_spam",
          "probability_like_score": 0.8495
